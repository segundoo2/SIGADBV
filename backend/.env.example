# API
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200/

# PostgreSQL. Docker Compose overrides DB_HOST inside its containers.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigadbv
DB_USER=sigadbv_app
DB_PASSWORD=
DB_SSL=false
# Keep certificate verification enabled unless the database provider requires otherwise.
DB_SSL_REJECT_UNAUTHORIZED=true
# Enable only if the PostgreSQL provider requires SCRAM channel binding.
DB_CHANNEL_BINDING=false

# Redis. Docker Compose overrides REDIS_URL for its containers.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Set distinct secrets with at least 32 bytes in production.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Initial administrator used by the production deploy script.
ADMIN_USERNAME=sg.code
ADMIN_PASSWORD=

# Docker Compose host ports.
API_PORT=3000
FRONTEND_PORT=8080
