# ==========================
# ⚙️ CONFIGURAÇÕES DA API
# ==========================
PORT=3000
NODE_ENV=development
# Separe por vírgula se tiver mais de um frontend (ex: admin na web e o app flutter)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3001,http://localhost:5173,https://sigadbv.sgcode.com.br

# Usada para deixa o link dinâmico no enum
FRONTEND_URL=http://localhost:4200/

# ==========================
# 🗄️ BANCO DE DADOS (PostgreSQL)
# ==========================
DATABASE_URL=postgresql://username:password@localhost:5432/sigadbv

# para seed de criação de primeiro usuário
ADMIN_USERNAME =
ADMIN_PASSWORD =

# ==========================
# REDIS (Blacklist de Tokens e Cache)
#               CONEXÃO TCP
# ==========================
REDIS_URL=
# Deixe em branco se rodar no Docker local sem senha
REDIS_PASSWORD=

# ==========================
# 🔐 AUTENTICAÇÃO E SEGURANÇA (JWT)
# ==========================
# Em desenvolvimento, valores vazios são substituídos por secrets aleatórios efêmeros.
# Em produção, configure dois secrets distintos com pelo menos 32 bytes.
# Gere cada valor localmente com: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Tempos de expiração
ACCESS_TOKEN_EXPIRES_IN = 15m
REFRESH_TOKEN_EXPIRES_IN = 7d